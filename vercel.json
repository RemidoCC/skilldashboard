{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "0 7,19 * * *"
    }
  ]
}
