# Supabase project (Skill Unit)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The only address allowed to sign in. The database enforces this too
# (see supabase/migrations/0003_auth.sql).
ALLOWED_EMAIL=you@example.com
# Used to build the magic-link redirect. On Vercel set this to the deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. The scheduled jobs have no session, so they use the service role
# to reach past RLS. Find it in the Supabase dashboard under Project Settings,
# API. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends `Authorization: Bearer $CRON_SECRET` to the cron routes.
# Any long random string; set the same value in the Vercel project settings.
CRON_SECRET=

# Google, read-only: calendar.readonly and gmail.readonly.
# Create an OAuth client (type: Web application) in the Google Cloud Console
# and add <site>/api/integrations/google/callback as an authorised redirect URI.
# Both are server-only; neither may be prefixed NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
